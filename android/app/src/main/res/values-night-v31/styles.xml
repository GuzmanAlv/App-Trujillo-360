        <item name="android:windowSplashScreenBackground">#f4f6f2</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/startup_empty_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#f4f6f2</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
